# 🐘 Conexão PostgreSQL (Neon, Docker, etc.)
# Copie para .env e ajuste os valores.
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# JWT (obrigatório em produção)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# URL base da aplicação (usada no link de reset de senha)
APP_URL="http://localhost:3000"

# SMTP (opcional — se ausente, o link é logado no console em modo dev)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# SMTP_FROM="noreply@fastfrete.com"
